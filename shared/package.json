{
  "name": "@ask-jev/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dependency-free documentation catalog shared by the API and playground",
  "engines": { "node": ">=24" },
  "files": ["dist", "src"],
  "sideEffects": false,
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "prepack": "pnpm build"
  }
}
