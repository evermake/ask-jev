{
  "name": "ask-jev",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun scripts/build.ts",
    "dev": "bun scripts/serve.ts",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc -p worker/tsconfig.json",
    "test": "bun test src worker",
    "check": "bun run typecheck && bun test src worker && bun run build"
  },
  "dependencies": {
    "effect": "4.0.5",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-to-string": "4.0.0",
    "micromark-extension-gfm": "3.0.0",
    "unist-util-visit": "5.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261106.1",
    "@types/bun": "1.4.2",
    "@types/mdast": "4.0.4",
    "typescript": "7.0.2",
    "wrangler": "4.158.0"
  }
}
