{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ask-jev-api",
  "main": "src/index.ts",
  "upload_source_maps": true,
  "assets": {
    "directory": "../playground/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "compatibility_date": "2026-11-06",
  "compatibility_flags": ["enable_request_signal"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "ask-jev.evermake.me", "custom_domain": true }
  ],
  "secrets": { "required": ["OPENROUTER_API_KEY"] },
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173",
  },
  "durable_objects": {
    "bindings": [{ "name": "HTTP_CACHE", "class_name": "HttpCacheObject" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HttpCacheObject"] }],
  "ratelimits": [
    {
      "name": "REQUEST_LIMITER",
      "namespace_id": "538561",
      "simple": { "limit": 120, "period": 60 },
    },
    {
      "name": "SEARCH_LIMITER",
      "namespace_id": "538562",
      "simple": { "limit": 5, "period": 60 },
    },
    {
      "name": "DEMO_LIMITER",
      "namespace_id": "538563",
      "simple": { "limit": 20, "period": 60 },
    },
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false
    }
  },
}
